# AgentMaster dependency repos
# Format: name|clone-url|skill_source[|exclude-glob]
#   name         — cache directory name; also the key used in repos.pins
#   clone-url    — git clone URL
#   skill_source — path inside the repo containing skill directories ("." for repo root)
#   exclude-glob — OPTIONAL 4th field: one or more SPACE-SEPARATED shell globs of skill
#                  dir names to SKIP when the source dir mixes end-user skills with ones
#                  you don't want installed (e.g. a repo's own contributor/maintainer
#                  skills, or a vendor's internal/product skills). Match any glob -> skip.
#
# Personal additions go in ~/.claude/.agentmaster-cache/repos.local (same format);
# they are merged after this file and survive AgentMaster self-updates.
caveman|https://github.com/JuliusBrussee/caveman.git|skills
superpowers|https://github.com/obra/superpowers.git|skills
claude-skills|https://github.com/alirezarezvani/claude-skills.git|.
claude-mem|https://github.com/thedotmack/claude-mem.git|plugin/skills
impeccable|https://github.com/pbakaus/impeccable.git|plugin/skills
anthropic-official|https://github.com/anthropics/skills.git|skills

# Design direction and UI review. Keep Vercel limited to the requested guidelines.
# Recheck exclusions when upstream adds skill directories.
taste-skill|https://github.com/Leonxlnx/taste-skill.git|skills
vercel-design|https://github.com/vercel-labs/agent-skills.git|skills|composition-patterns deploy-to-vercel react-best-practices react-native-skills react-view-transitions vercel-cli-with-tokens vercel-optimize writing-guidelines

# Curated subsets — one upstream repo, multiple skill_source lines under the
# same name so the installer/updater clone it once and copy each subset dir.
# Reject: davila7's document-processing category (skills named docx/pdf/pptx/xlsx
# collide with anthropic-official's) — deliberately not wired to avoid overwriting
# the official document skills. Other davila7/wshobson categories exist unwired
# (see agents.md for the full survey); add lines here if you want more.
wshobson|https://github.com/wshobson/agents.git|plugins/backend-development/skills
wshobson|https://github.com/wshobson/agents.git|plugins/security-scanning/skills
wshobson|https://github.com/wshobson/agents.git|plugins/llm-application-dev/skills
wshobson|https://github.com/wshobson/agents.git|plugins/cicd-automation/skills
wshobson|https://github.com/wshobson/agents.git|plugins/kubernetes-operations/skills
wshobson|https://github.com/wshobson/agents.git|plugins/python-development/skills
# Second wave (2026-09-09) — 9 collision-free subsets filling frontend/JS-TS, cloud,
# observability, and general-dev gaps (50 skills). Verified no collisions with installed.
wshobson|https://github.com/wshobson/agents.git|plugins/javascript-typescript/skills
wshobson|https://github.com/wshobson/agents.git|plugins/frontend-mobile-development/skills
wshobson|https://github.com/wshobson/agents.git|plugins/ui-design/skills
wshobson|https://github.com/wshobson/agents.git|plugins/cloud-infrastructure/skills
wshobson|https://github.com/wshobson/agents.git|plugins/observability-monitoring/skills
wshobson|https://github.com/wshobson/agents.git|plugins/incident-response/skills
wshobson|https://github.com/wshobson/agents.git|plugins/developer-essentials/skills
wshobson|https://github.com/wshobson/agents.git|plugins/data-engineering/skills
wshobson|https://github.com/wshobson/agents.git|plugins/documentation-generation/skills
davila7|https://github.com/davila7/claude-code-templates.git|cli-tool/components/skills/git
davila7|https://github.com/davila7/claude-code-templates.git|cli-tool/components/skills/database

# REA — "Reverse Engineer Anything" (MIT). Reverse-engineering / binary-analysis skill
# backed by the REA MCP server. Its .agents/skills dir holds 5 skills, but 4 (rea-*) are
# REA-contributor/maintainer skills (tool design, CI audit, changelog, analysis-opt) — the
# exclude-glob drops them so only the end-user `reverse-engineer-anything` skill installs.
# NOTE: the skill references REA's MCP tools (native/APK/firmware/.NET/wasm/EVM providers,
# close_binary, etc.) which only exist after a ONE-TIME `npx rea-agents setup` — the skill
# installs via this manifest, but the MCP server must be set up separately. See AGENTS.md.
rea|https://github.com/morluto/rea.git|.agents/skills|rea-*

# debug-skill — live DAP debugger (MIT). Skill `debugging-code`: breakpoints, stepping,
# variable/stack inspection across Python/Go/Node/Rust/C++. Two-part like REA: the skill
# installs here, but its tools need the `dap` CLI (brew install almogbaku/tap/dap, or from
# source) — AgentMaster must NOT auto-install it; the routing row tells the agent to prompt.
debug-skill|https://github.com/AlmogBaku/debug-skill.git|skills

# ida-pro-mcp — IDAPython scripting skill + MCP server (MIT). Skill `idapython`. Overlaps
# REA's native path but is distinct (drives IDA Pro directly). Prerequisite: IDA Pro + the
# ida-pro-mcp server (its own `pip install ida-pro-mcp && ida-pro-mcp --install`). Prompt, don't auto-install.
ida-pro-mcp|https://github.com/mrexodia/ida-pro-mcp.git|skills

# agent-browser — Vercel's headless browser-automation CLI (Apache-2.0). skill-data holds 9
# skills but 8 are Vercel-internal/product (agentcore, derive-client, dogfood, electron,
# protected-vercel-deployments, slack, vercel-sandbox, webmcp-gen) — excluded so only the
# general `core` browser skill installs. Needs the agent-browser Rust CLI. NOTE: if Vercel
# adds a new internal skill, add it to this exclude list (exclude-only can't auto-drop it).
agent-browser|https://github.com/vercel-labs/agent-browser.git|skill-data|agentcore derive-client dogfood electron protected-vercel-deployments slack vercel-sandbox webmcp-gen

# crowdcast — multi-agent social simulation skill (`/crowdcast simulate`), zero deps.
# OPT-IN / NOT WIRED BY DEFAULT: NO LICENSE declared upstream (all-rights-reserved by
# default), so it is deliberately NOT in the committed set — shipping AgentMaster must not
# redistribute all-rights-reserved code. To use it personally, add this line (uncommented)
# to ~/.claude/.agentmaster-cache/repos.local, which is machine-local and never committed.
# crowdcast|https://github.com/TheQmaks/crowdcast.git|skills

# scientific-agent-skills — 177 science skills + 100+ DBs (MIT): biology, chemistry,
# medicine, drug discovery. OPT-IN / NOT WIRED BY DEFAULT: it is the heaviest dependency by
# far — a `full` install would balloon from ~200 to ~380 skills and grow the unrouted
# fallback by 177 entries, diluting routing for a domain most repos here never touch.
# No name collisions with installed skills (verified 2026-10-19). To enable, UNCOMMENT the
# line below and run `/agent-master update` (or add it to repos.local for machine-local use).
# scientific-agent-skills|https://github.com/K-Dense-AI/scientific-agent-skills.git|skills
